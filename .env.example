# 对外端口（映射到容器 8000）
PORT=8080

# 管理口令 / JWT（仅这两项必须用环境变量）
ADMIN_PASSWORD=change-me-admin
JWT_SECRET=please-use-a-long-random-string

# 上游超时（秒）；Base URL / API Key / Model 在管理后台配置
UPSTREAM_TIMEOUT_SECONDS=300

# 可选
# 外网域名（反向代理未正确转发 Host / X-Forwarded-Proto 时建议配置）
# PUBLIC_BASE_URL=https://images.example.com
# 生产环境保持 false；仅本地调试时可改为 true。
# ENABLE_DOCS=false
# CORS_ORIGINS=*
